# zsh completion for plexdo
#
# Installation:
#   Per user:    cp _plexdo ~/.local/share/zsh/site-functions/
#                (ensure that directory is in $fpath, then: compinit)
#   System-wide: cp _plexdo /usr/local/share/zsh/site-functions/
#
# Completion for user IDs, library IDs, rating keys, playlists, and albums is
# read from the 15-minute cache that the list commands populate, in plex:
# cache_dir or else $XDG_CACHE_HOME/plexdo, by default ~/.cache/plexdo. A
# stale cache is refreshed in the background so completion never blocks; the values shown come from whatever is cached at that moment.

# Some systems ship "python" but not "python3".
_plexdo_python() {
  if (( $+commands[python3] )); then print -r -- python3; else print -r -- python; fi
}

(( $+functions[_plexdo_cache_dir] )) || _plexdo_cache_dir() {
  # Memoised: this reads the config file to honour plex: cache_dir, so it
  # should not run once per completion candidate.
  if [[ -z $_plexdo_cache_resolved ]]; then
    typeset -g _plexdo_cache_resolved
    _plexdo_cache_resolved="$("$(_plexdo_python)" - <<'PYCACHE' 2>/dev/null
import json, os
from pathlib import Path
def xdg(name, fallback):
    value = os.environ.get(name, "")
    if value and Path(value).is_absolute():
        return Path(value)
    return Path(fallback).expanduser()
if os.name == "nt":
    root = os.environ.get("LOCALAPPDATA") or os.environ.get("APPDATA")
    app = Path(root) / "PlexDo" if root else Path.home() / "AppData/Local/PlexDo"
    cfg_path, default = app / "config.yaml", app / "Cache"
else:
    cfg_path = xdg("XDG_CONFIG_HOME", "~/.config") / "plexdo" / "config.yaml"
    default = xdg("XDG_CACHE_HOME", "~/.cache") / "plexdo"
try:
    lines = cfg_path.read_text(encoding="utf-8").splitlines()
except OSError:
    lines = []
# The one value wanted is a scalar directly under plex:, so the file is
# read a line at a time; PyYAML may not be importable from this python.
value, in_plex, dq, sq = "", False, chr(34), chr(39)
for line in lines:
    text = line.strip()
    if not text or text.startswith("#") or text == "---":
        continue
    if line[:1] not in (" ", chr(9)):
        in_plex = text.split(":")[0].strip() == "plex"
        continue
    key, colon, rest = text.partition(":")
    if not (in_plex and colon and key.strip() == "cache_dir"):
        continue
    rest = rest.strip()
    if rest[:1] == dq:
        try:
            rest = json.JSONDecoder().raw_decode(rest)[0]
        except ValueError:
            rest = rest.strip(dq)
    elif rest[:1] == sq and sq in rest[1:]:
        rest = rest[1:rest.rindex(sq)].replace(sq + sq, sq)
    else:
        rest = rest.split(" #")[0].strip()
    value = "" if rest in ("null", "~") else str(rest)
print(Path(os.path.expandvars(value)).expanduser() if value else default)
PYCACHE
)"
  fi
  print -r -- "$_plexdo_cache_resolved"
}

# Return 0 when the cache file exists and is under 15 minutes old.
_plexdo_cache_fresh() {
  local file=$1 now mtime
  [[ -f $file ]] || return 1
  now=$(date +%s)
  mtime=$(stat -c %Y "$file" 2>/dev/null) || mtime=$(stat -f %m "$file" 2>/dev/null) || return 1
  (( now - mtime < 900 ))
}

# Run a plexdo list command in the background purely for its cache side effect.
_plexdo_refresh() {
  local prog=${words[1]:-plexdo}
  ( "$prog" "$@" >/dev/null 2>&1 & ) 2>/dev/null
}

# Emit "value" or "value:description" lines from a JSON cache file.
_plexdo_read_cache() {
  local file=$1 field=$2 desc=$3
  [[ -f $file ]] || return
  python3 - "$file" "$field" "$desc" <<'PY' 2>/dev/null
import json, sys
path, field, desc = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    rows = json.load(open(path, encoding="utf-8"))
except Exception:
    sys.exit(0)
for row in rows:
    value = str(row.get(field, "")).strip()
    if not value:
        continue
    if desc:
        label = str(row.get(desc, "")).strip().replace(":", " ")
        print(f"{value}:{label}" if label else value)
    else:
        print(value)
PY
}

_plexdo_users() {
  local cache="$(_plexdo_cache_dir)/users.json"
  _plexdo_cache_fresh $cache || _plexdo_refresh users-list
  local -a ids titles
  ids=( '0:admin account' ${(f)"$(_plexdo_read_cache $cache id title)"} )
  titles=( ${(f)"$(_plexdo_read_cache $cache title '')"} )
  _describe -t user-ids 'user id' ids
  [[ -n $titles ]] && _describe -t user-titles 'user title' titles
}

_plexdo_libraries() {
  local cache="$(_plexdo_cache_dir)/libraries.json"
  _plexdo_cache_fresh $cache || _plexdo_refresh libraries-list
  local -a libs titles
  libs=( ${(f)"$(_plexdo_read_cache $cache id title)"} )
  titles=( ${(f)"$(_plexdo_read_cache $cache title '')"} )
  _describe -t library-ids 'library id' libs
  [[ -n $titles ]] && _describe -t library-titles 'library title' titles
}

_plexdo_rating_keys() {
  local dir="$(_plexdo_cache_dir)" file lib
  local -a keys
  for file in $dir/titles.*.json(N); do
    if ! _plexdo_cache_fresh $file; then
      lib=${${file:t}#titles.}; lib=${lib%.json}
      _plexdo_refresh library-list $lib
    fi
    keys+=( ${(f)"$(_plexdo_read_cache $file ratingKey title)"} )
  done
  if (( ! ${#keys} )); then
    _plexdo_refresh libraries-list
    _message 'rating key (run library-list <library_id> to populate completion)'
    return
  fi
  _describe -t rating-keys 'rating key' keys
}

# A word typed for a user or library, as the name plexdo files its by-word
# cache under: every character a file name cannot hold replaced by "_", as
# plexdo's cache_key does. plexdo writes that cache for the ID, the title,
# and the word as typed, so whichever is on the command line finds it.
_plexdo_word_key() {
  print -r -- ${1//[\/\\:\*\?\"\<\>\|]/_}
}

# $1 is the user id or title already typed on the command line.
_plexdo_playlists() {
  local user=${(Q)${1:-0}} dir="$(_plexdo_cache_dir)"
  local cache="$dir/playlists-by-word.$(_plexdo_word_key $user).json"
  _plexdo_cache_fresh $cache || _plexdo_refresh playlists-list $user
  local -a names
  names=( ${(f)"$(_plexdo_read_cache $cache title '')"} )
  if (( ${#names} )); then
    _describe -t playlists 'playlist' names
  else
    _message 'playlist title'
  fi
}

# Playlists by title or ratingKey, for playlist-list which accepts either.
_plexdo_playlists_or_keys() {
  local user=${(Q)${1:-0}}
  local cache="$(_plexdo_cache_dir)/playlists-by-word.$(_plexdo_word_key $user).json"
  _plexdo_cache_fresh $cache || _plexdo_refresh playlists-list $user
  local -a names keys
  names=( ${(f)"$(_plexdo_read_cache $cache title '')"} )
  keys=( ${(f)"$(_plexdo_read_cache $cache ratingKey title)"} )
  [[ -n $names ]] && _describe -t playlists 'playlist' names
  [[ -n $keys ]] && _describe -t playlist-keys 'playlist ratingKey' keys
}

# Album names, derived from the "Album - Photo" titles cached for a library.
_plexdo_albums() {
  local lib=${(Q)${1:-}}
  local cache="$(_plexdo_cache_dir)/titles-by-word.$(_plexdo_word_key $lib).json"
  [[ -z $lib ]] && { _message 'album name'; return }
  _plexdo_cache_fresh $cache || _plexdo_refresh library-list $lib
  local -a albums
  albums=( ${(fu)"$(_plexdo_read_cache $cache title '' | sed -n 's/ - .*//p')"} )
  if (( ${#albums} )); then
    _describe -t albums 'album' albums
  else
    _message 'album name'
  fi
}

# Nth (0-based) positional argument after the subcommand, "" when absent.
_plexdo_positional() {
  local want=$1 i=2 skip=0 count=0
  for (( i = 2; i <= $#words - 1; i++ )); do
    if (( skip )); then skip=0; continue; fi
    case ${words[i]} in
      --m3u|--album|--sort|--media-type|--library-id|-l|--library|-t|--title|\
      -u|--username|-p|--password|-c|--code|-f|--format|--section|-p|--prefix|--throttle|\
      --ratio|--debug-log) skip=1; continue ;;
      -*) continue ;;
    esac
    if (( count == want )); then print -r -- ${words[i]}; return; fi
    (( count++ ))
  done
}

_plexdo_commands() {
  local -a cmds
  cmds=(
    'album-list:Show one album with its played state and progress'
    'albums-list:List the albums in a music or photo library'
    'libraries-list:List the server'\''s libraries'
    'library-list:List the titles in a library'
    'login:Sign in to plex.tv and save the token'
    'logout:Sign out of plex.tv and remove the saved tokens'
    'merge-build:Mix two playlists into a new one at a ratio'
    'missing-find:Find gaps in the episode numbering of a show'
    'player-remote-play:Tell a player, reached directly, to play an item'
    'playlist-build:Build a playlist, or add items to one'
    'playlist-clean:Remove the watched items from a playlist'
    'playlist-copy:Copy a playlist to one user, or to all of them'
    'playlist-export:Export a playlist to an M3U file'
    'playlist-list:List the items in a playlist'
    'playlist-remove:Delete a playlist'
    'playlists-list:List a user'\''s playlists'
    'read:Stream a media file to stdout'
    'rescan:Rescan libraries, or show the scans under way'
    'search:Search for titles matching a query'
    'set-pin:Save or remove a Plex Home member'\''s PIN'
    'show-list:List a show'\''s episodes'
    'show-metadata:Show the metadata of one item'
    'show-watched-cp:Sync watched state and resume points of two users'
    'status:Show the server'\''s sessions, users, scans, and tasks'
    'titles-export:Export a library to an M3U file or photo gallery'
    'users-list:List the server'\''s users'
    'wait:Sleep until a session'\''s current play is over'
    'write-config-example:Write a template configuration file'
