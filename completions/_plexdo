  _describe -t commands 'plexdo command' cmds
}

# The mode flag given to playlist-build or playlist-copy; nothing when none
# has been typed yet. The mode decides what each positional argument is.
_plexdo_mode() {
  local word
  for word in ${words[2,-1]}; do
    case $word in
      -I|--interleaved) echo interleaved; return ;;
      -C|--chronological) echo chronological; return ;;
      -R|--randomize) echo randomize; return ;;
      -A|--append|--all) echo all-or-append; return ;;
      -T|--to) echo to; return ;;
    esac
  done
}

_plexdo_global_opts=(
  '--json[Output machine-readable JSON instead of tables]'
  '--verbose[Print high-level progress to stderr]'
  '--debug[Print detailed internal logs to stderr]'
  '--debug-log[Append the debug logs, profiled and timestamped, to a file]:debug log:_files'
  '--dry-run[Show what would happen without mutating Plex]'
  '(-W --wide)'{-W,--wide}'[Do not shrink table columns to the terminal width]'
  '--throttle[Seconds between requests in per-item operations; 0 disables]:seconds:'
  '(-h --help)'{-h,--help}'[Show this help message and exit]'
)

_plexdo_subcommand() {
  local m3u='--m3u[Also export an M3U file using Plex server paths]:m3u path:_files'
  # Arrays, not scalars: only an array assignment expands the braces.
  local -a pfx over target
  pfx=('(-p --prefix)'{-p,--prefix}'[Rewrite exported paths onto this prefix]:prefix:')
  over=('(-o --overwrite)'{-o,--overwrite}'[Replace an existing playlist of the same name]')
  target=(
    '(-u --user -a --all-users)'{-u,--user}'[Create it for this user instead]:user:_plexdo_users'
    '(-u --user -a --all-users)'{-a,--all-users}'[Create it for every user on the server]'
  )
  case ${words[1]} in
    library-list)
      _arguments $_plexdo_global_opts \
        '--album[Photo libraries only: restrict to one album]:album:{_plexdo_albums $(_plexdo_positional 0)}' \
        '1:library id:_plexdo_libraries'
      ;;
    albums-list)
      _arguments $_plexdo_global_opts '1:library id:_plexdo_libraries'
      ;;
    show-list)
      _arguments $_plexdo_global_opts $pfx $m3u '1:show rating key:_plexdo_rating_keys'
      ;;
    show-metadata|album-list)
      _arguments $_plexdo_global_opts '1:rating key:_plexdo_rating_keys'
      ;;
    titles-export)
      _arguments $_plexdo_global_opts $pfx \
        '--sort[Sort order]:order:(alpha date random)' \
        '--album[Photo libraries only: restrict to one album]:album:{_plexdo_albums $(_plexdo_positional 0)}' \
        '1:library id:_plexdo_libraries' \
        '2:output path:_files'
      ;;
    search)
      _arguments $_plexdo_global_opts \
        '--media-type[Restrict to one media type]:type:(movie show episode track photo album artist)' \
        '--library-id[Restrict to one library]:library id:_plexdo_libraries' \
        '1:user:_plexdo_users' \
        '2:query:'
      ;;
    status)
      _arguments $_plexdo_global_opts \
        '--section[Show only one section]:section:(server sessions users accounts connections scans activities tasks)'
      ;;
    users-list|libraries-list)
      _arguments $_plexdo_global_opts
      ;;
    write-config-example)
      _arguments $_plexdo_global_opts \
        '(-o --overwrite)'{-o,--overwrite}'[Replace an existing config file]'
      ;;
    write-secrets-example)
      _arguments $_plexdo_global_opts \
        '(-o --overwrite)'{-o,--overwrite}'[Replace an existing secrets file]'
      ;;
    playlists-list)
      _arguments $_plexdo_global_opts '1:user:_plexdo_users'
      ;;
    playlist-list)
      _arguments $_plexdo_global_opts $pfx $m3u \
        '1:user:_plexdo_users' \
        '2:playlist:{_plexdo_playlists_or_keys $(_plexdo_positional 0)}'
      ;;
    playlist-export)
      _arguments $_plexdo_global_opts $pfx \
        '1:user:_plexdo_users' \
        '2:playlist:{_plexdo_playlists_or_keys $(_plexdo_positional 0)}' \
        '3:output path:_files'
      ;;
    wait)
      _arguments $_plexdo_global_opts \
        '(-s --session -a --all)'{-s,--session}'[Follow the session with this sessionKey]:session key:' \
        '(-r --rating-key -a --all)'{-r,--rating-key}'[Wait for this video]:rating key:_plexdo_rating_keys' \
        '(-a --all -s --session -r --rating-key)'{-a,--all}'[Wait for every play by every user]' \
        '(-i --interval)'{-i,--interval}'[Seconds between polls]:seconds:' \
        '--fast-interval[Seconds between polls near the end point]:seconds:' \
        '--no-credits[Ignore the credits marker and wait for the end]' \
        '--offset[Signed seconds: negative ends early, positive sleeps after]:seconds:' \
        '--paused[Count a play as over once paused this many seconds]:seconds:' \
        '--now[With -r: exit at once if the video is not playing]'
      ;;
    player-remote-play)
      _arguments $_plexdo_global_opts \
        '--port[Port the player listens on for remote control]:port:' \
        '--player-user[Account signed in to the player: user id, username, or email]:user:' \
        '--server-url[Server address the player should fetch from]:url:' \
        '1:player host name or address:_hosts' \
        '2:rating key:_plexdo_rating_keys'
      ;;
    playlist-clean)
      _arguments $_plexdo_global_opts \
        '--include-partial[Also remove part-played items]' \
        '1:user:_plexdo_users' \
        '2:playlist:{_plexdo_playlists_or_keys $(_plexdo_positional 0)}'
      ;;
    playlist-remove)
      _arguments $_plexdo_global_opts \
        '1:user:_plexdo_users' \
        '2:playlist:{_plexdo_playlists_or_keys $(_plexdo_positional 0)}'
      ;;
    read)
      _arguments $_plexdo_global_opts '1:rating key:_plexdo_rating_keys'
      ;;
    missing-find)
      _arguments $_plexdo_global_opts \
        '(-l --library)'{-l,--library}'[Library to look in]:library:_plexdo_libraries' \
        '(-A --all)'{-A,--all}'[Check every show]' \
        '(-s --season)'{-s,--season}'[Season number, or several comma separated]:seasons:' \
        '--include-specials[Also check season 0]' \
        '1:show:_plexdo_rating_keys'
      ;;
    rescan)
      _arguments $_plexdo_global_opts \
        '(-a --all)'{-a,--all}'[Rescan every library]' \
        '(-s --status)'{-s,--status}'[Print all active scan jobs]' \
        '(-n --now)'{-n,--now}'[Cancel pending scans before rescanning]' \
        '1:library id:_plexdo_libraries'
      ;;
    playlist-build)
      local modes='(-I --interleaved -C --chronological -R --randomize -A --append)'
      local -a how
      how=(
        $modes{-I,--interleaved}'[Take one episode from each show in turn]'
        $modes{-C,--chronological}'[Sort the episodes and movies by air date]'
        $modes{-R,--randomize}'[Shuffle an existing playlist into a new one]'
        $modes{-A,--append}'[Add items to the end of an existing playlist]'
      )
      case $(_plexdo_mode) in
        interleaved|chronological)
          _arguments $_plexdo_global_opts $how $pfx $m3u $target $over \
            '1:playlist name:' \
            '*:rating key:_plexdo_rating_keys'
          ;;
        randomize)
          _arguments $_plexdo_global_opts $how $pfx $m3u $target $over \
            '1:user:_plexdo_users' \
            '2:source playlist:{_plexdo_playlists_or_keys $(_plexdo_positional 0)}' \
            '3:destination playlist:'
          ;;
        all-or-append)
          _arguments $_plexdo_global_opts $how \
            '1:user:_plexdo_users' \
            '2:playlist:{_plexdo_playlists_or_keys $(_plexdo_positional 0)}' \
            '*:rating key:_plexdo_rating_keys'
          ;;
        *)
          # No mode yet, so nothing says what an argument would be.
          _arguments $_plexdo_global_opts $how $pfx $m3u $target $over
          ;;
      esac
      ;;
    merge-build)
      _arguments $_plexdo_global_opts $pfx $m3u $target \
        '(-o --overwrite)'{-o,--overwrite}'[Replace an existing playlist of the same name]' \
        '--ratio[Take A items from the first, then B from the second]:ratio (A\:B):' \
        '(-s --stop-short)'{-s,--stop-short}'[Stop when either playlist runs out]' \
        '(-U --unique)'{-U,--unique}'[Skip an item already taken]' \
        '1:user:_plexdo_users' \
        '2:new playlist name:' \
        '3:first playlist:{_plexdo_playlists_or_keys $(_plexdo_positional 0)}' \
        '4:second playlist:{_plexdo_playlists_or_keys $(_plexdo_positional 0)}'
      ;;
    playlist-copy)
      local -a whom
      whom=(
        '(-A --all -T --to)'{-A,--all}'[Copy to every user the server is shared with]'
        '(-A --all -T --to)'{-T,--to}'[Copy to one user, under a title of your choosing]'
        '(-o --overwrite)'{-o,--overwrite}'[Overwrite an existing playlist of the same name]'
      )
      if [[ $(_plexdo_mode) == to ]]; then
        _arguments $_plexdo_global_opts $whom \
          '1:source user:_plexdo_users' \
          '2:source playlist:{_plexdo_playlists_or_keys $(_plexdo_positional 0)}' \
          '3:target user:_plexdo_users' \
          '4:destination playlist:'
      else
        _arguments $_plexdo_global_opts $whom \
          '1:source user:_plexdo_users' \
          '2:source playlist:{_plexdo_playlists_or_keys $(_plexdo_positional 0)}'
      fi
      ;;
    show-watched-cp)
      _arguments $_plexdo_global_opts \
        '(-1 --one-way)'{-1,--one-way}'[Only write to the second user]' \
        '(-l --library)'{-l,--library}'[Restrict to one library]:library id:_plexdo_libraries' \
        '(-t --title)'{-t,--title}'[Restrict to one item]:rating key:_plexdo_rating_keys' \
        '--unwatch[Propagate the unwatched state instead]' \
        '1:first user:_plexdo_users' \
        '2:second user:_plexdo_users'
      ;;
    login)
      _arguments $_plexdo_global_opts \
        '(-u --username)'{-u,--username}'[Plex username or email]:username:' \
        '(-p --password)'{-p,--password}'[Plex password (INSECURE: visible in ps and shell history)]:password:' \
        '--save-password[Also save the password in the system keyring]' \
        '(-c --code)'{-c,--code}'[Two-factor authentication code]:code:' \
        '(-2 --two-factor)'{-2,--two-factor}'[Prompt for a two-factor code]'
      ;;
    logout)
      _arguments $_plexdo_global_opts \
        '(-u --username)'{-u,--username}'[Sign out only this saved name]:username:'
      ;;
    set-pin)
      _arguments $_plexdo_global_opts \
        '--remove[Remove the saved PIN instead of prompting for one]' \
        '1:user:_plexdo_users'
      ;;
    *)
      _arguments $_plexdo_global_opts
      ;;
  esac
}

_plexdo() {
  local curcontext="$curcontext" state line
  typeset -A opt_args
  _arguments -C $_plexdo_global_opts \
    '1:command:_plexdo_commands' \
    '*::command argument:->subcmd'
  [[ $state == subcmd ]] && _plexdo_subcommand
}

_plexdo "$@"
